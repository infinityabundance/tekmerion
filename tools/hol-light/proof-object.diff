 (* ------------------------------------------------------------------------- *)
+(* Proof-object recording.                                                    *)
+(*                                                                            *)
+(* Every primitive inference appends one node to a raw stream:                *)
+(*                                                                            *)
+(*   tag=1  len(u32)  rule(u8)  p0(u32)  p1(u32)  plen(u32)  payload           *)
+(*                                                                            *)
+(* where p0/p1 are the node ids of the parents (0xFFFFFFFF = absent) and the  *)
+(* payload is the rule's term-level input, encoded structurally below.  A      *)
+(* final tag=2 record carries the root id, conclusion, hypotheses and axiom   *)
+(* registry.  Integers are big-endian.  Nothing is kept in memory except the  *)
+(* counter, so resident memory grows with the live proof, not the stream.      *)
+(*                                                                            *)
+(* Rule tags: 0 REFL, 1 TRANS, 2 MK_COMB, 3 ABS, 4 BETA, 5 ASSUME,             *)
+(*            6 EQ_MP, 7 DEDUCT_ANTISYM_RULE, 8 INST_TYPE, 9 INST,            *)
+(*            10 new_axiom, 11 new_basic_definition,                         *)
+(*            12 new_basic_type_definition (first result),                    *)
+(*            13 new_basic_type_definition (second result).                   *)
+(*                                                                            *)
+(* Term encoding: 0 Var(name,type) 1 Const(name,type) 2 Comb(f,x)             *)
+(*                3 Abs(var-term,body).  Type encoding: 0 Tyvar(name)          *)
+(*                1 Tyapp(name,[args]).  Names and strings are u32 length +    *)
+(*                bytes.  Every variable and constant carries its full type,  *)
+(*                so the stream is self-contained: a reader needs no global   *)
+(*                signature to reconstruct or type-check it.                  *)
+(* ------------------------------------------------------------------------- *)
+
+  let po_channel = ref (None : out_channel option)
+
+  let po_nodes = ref 0
+
+  (* Recording is off until [proof_record_begin].  The ambient library is
+     built before that point at module initialisation, so its theorems carry
+     node id -1; when such a theorem is used as a parent it is emitted as an
+     IMPORT leaf (rule 14) recording its full sequent. *) 
+  let po_active = ref false
+
+  let po_begin_inferences = ref 0
+
+  let import_table : (string,int) Hashtbl.t = Hashtbl.create 1024
+
+  let proof_enabled () = !po_channel <> None
+
+  let proof_node_count () = !po_nodes
+
+  let () =
+    match Sys.getenv_opt "TEKMERION_PROOF_RAW" with
+    | Some p when p <> "" ->
+        let oc =
+          try open_out_bin p
+          with Sys_error m ->
+            failwith ("proof_object: cannot open raw stream " ^ p ^ ": " ^ m) in
+        output_string oc "HLRAW1\n";
+        flush oc;
+        po_channel := Some oc
+    | _ -> ()
+
+  let put_u8 b v = Buffer.add_char b (Char.chr (v land 0xff))
+
+  let put_u32 b v =
+    Buffer.add_char b (Char.chr ((v lsr 24) land 0xff));
+    Buffer.add_char b (Char.chr ((v lsr 16) land 0xff));
+    Buffer.add_char b (Char.chr ((v lsr 8) land 0xff));
+    Buffer.add_char b (Char.chr (v land 0xff))
+
+  let put_str b s = put_u32 b (String.length s); Buffer.add_string b s
+
+  let out_u32 oc v =
+    output_char oc (Char.chr ((v lsr 24) land 0xff));
+    output_char oc (Char.chr ((v lsr 16) land 0xff));
+    output_char oc (Char.chr ((v lsr 8) land 0xff));
+    output_char oc (Char.chr (v land 0xff))
+
+  let rec put_type b ty =
+    match ty with
+      Tyvar v -> put_u8 b 0; put_str b v
+    | Tyapp(f,args) ->
+        put_u8 b 1; put_str b f; put_u32 b (List.length args);
+        List.iter (put_type b) args
+
+  let rec put_term b tm =
+    match tm with
+      Var(s,ty) -> put_u8 b 0; put_str b s; put_type b ty
+    | Const(s,ty) -> put_u8 b 1; put_str b s; put_type b ty
+    | Comb(f,x) -> put_u8 b 2; put_term b f; put_term b x
+    | Abs(v,bod) -> put_u8 b 3; put_term b v; put_term b bod
+
+  (* Emit one node.  The node id is allocated only when a node is actually   *)
+  (* written, so ids are dense and every recorded id is < the final count.    *)
+  let po_emit rule p0 p1 payload =
+    if not !po_active then -1 else
+    match !po_channel with
+      None -> -1
+    | Some oc ->
+        let id = !po_nodes in
+        incr po_nodes;
+        let plen = Buffer.length payload in
+        output_char oc (Char.chr 1);
+        out_u32 oc (1 + 4 + 4 + 4 + plen);
+        output_char oc (Char.chr rule);
+        out_u32 oc p0;
+        out_u32 oc p1;
+        out_u32 oc plen;
+        Buffer.output_buffer oc payload;
+        id
+
+  let proof_record_begin () =
+    po_active := (!po_channel <> None);
+    po_begin_inferences := inference_count ()
+
+  (* Materialise a parent.  A theorem created before recording began has no
+     node; emit (once) an IMPORT leaf carrying its hypotheses and conclusion. *)
+  let ensure_node asl c nid =
+    if not !po_active then -1
+    else if nid >= 0 then nid
+    else begin
+      let b = Buffer.create 256 in
+      put_u32 b (List.length asl);
+      List.iter (put_term b) asl;
+      put_term b c;
+      let key = Buffer.contents b in
+      match Hashtbl.find_opt import_table key with
+        Some id -> id
+      | None ->
+          let id = po_emit 14 (-1) (-1) b in
+          Hashtbl.add import_table key id;
+          id
+    end
+
+  let po_leaf rule tm =
+    if not !po_active then -1 else begin
+      let b = Buffer.create 64 in
+      put_term b tm;
+      po_emit rule (-1) (-1) b
+    end
+
+  let po_unary rule parent =
+    po_emit rule parent (-1) (Buffer.create 0)
+
+  let po_binary rule p0 p1 = po_emit rule p0 p1 (Buffer.create 0)
+
+  let po_term_arg rule parent tm =
+    if not !po_active then -1 else begin
+      let b = Buffer.create 64 in
+      put_term b tm;
+      po_emit rule parent (-1) b
+    end
+
+  (* The final record: root id, conclusion, hypotheses, inference count and  *)
+  (* axiom registry.  Written once, after the target theorem exists.         *)
+  let proof_export name (Sequent((asl,c),_,id)) =
+    match !po_channel with
+      None -> ()
+    | Some oc ->
+        let b = Buffer.create 1024 in
+        put_str b name;
+        put_u32 b id;
+        put_u32 b (List.length asl);
+        List.iter (put_term b) asl;
+        put_term b c;
+        put_u32 b (inference_count ());
+        put_u32 b !po_begin_inferences;
+        put_u32 b !po_nodes;
+        let reg = axiom_registry () in
+        put_u32 b (List.length reg);
+        List.iter
+          (fun (i,dg,txt) -> put_u32 b i; put_str b dg; put_str b txt) reg;
+        output_char oc (Char.chr 2);
+        out_u32 oc (Buffer.length b);
+        Buffer.output_buffer oc b;
+        flush oc
+
