+(* ------------------------------------------------------------------------- *)
+(* Axiom-stamp instrumentation.                                               *)
+(*                                                                           *)
+(* Every theorem carries a bitmask of the axioms its derivation touched.      *)
+(* A bit is allocated by `new_axiom`, so the three basic axioms get ids        *)
+(* automatically; nothing here knows their names.  An inference counter is     *)
+(* bumped once per primitive-rule invocation so a caller can measure the size *)
+(* of one derivation as a delta.  This is a measurement build: the kernel's    *)
+(* checks and semantics are untouched.                                        *)
+(* ------------------------------------------------------------------------- *)
+
+  let the_inference_count = ref 0
+
+  let inference_count () = !the_inference_count
+
+  let bump_inferences () = incr the_inference_count
+
+  let axiom_registry_data = ref ([] : (int * string) list)
+
+  let next_axiom_id = ref 0
+
+  let axiom_registry () = List.rev (!axiom_registry_data)
+
+  let mask_bit id = 1 lsl (id - 1)
+
+  let mask_union a b = a lor b
+
+  (* Structural rendering of a term.  No printer is available this early, so *)
+  (* this is a self-contained, fully parenthesised shape string.  It is       *)
+  (* deterministic and enough to identify an axiom's conclusion.             *)
+  let rec raw_term_string tm =
+    match tm with
+      Var(s,_) -> s
+    | Const(s,_) -> s
+    | Comb(f,x) -> "(" ^ raw_term_string f ^ " " ^ raw_term_string x ^ ")"
+    | Abs(Var(s,_),b) -> "(\\" ^ s ^ ". " ^ raw_term_string b ^ ")"
+    | Abs(_,b) -> "(\\_. " ^ raw_term_string b ^ ")"
+
+  (* Collapse runs of whitespace to single spaces, trimming both ends. *)
+  let collapse_ws s =
+    let n = String.length s in
+    let b = Buffer.create n in
+    let pending = ref false in
+    String.iter
+      (fun c ->
+         match c with
+           ' ' | '\t' | '\n' | '\r' -> pending := true
+         | _ -> if !pending && Buffer.length b > 0 then Buffer.add_char b ' ';
+                pending := false;
+                Buffer.add_char b c)
+      s;
+    Buffer.contents b
+
+  let register_axiom tm =
+    incr next_axiom_id;
+    let id = !next_axiom_id in
+    let text = collapse_ws (raw_term_string tm) in
+    axiom_registry_data := (id,text) :: !axiom_registry_data;
+    id
+
+  let mask_ids mask =
+    let rec scan i m acc =
+      if m = 0 then acc
+      else if m land 1 = 1 then scan (i + 1) (m lsr 1) (i :: acc)
+      else scan (i + 1) (m lsr 1) acc in
+    List.rev (scan 1 mask [])
+
+  let truncate_80 s =
+    if String.length s > 80 then String.sub s 0 80 else s
+
+  let stamp_of (Sequent(_,mask)) = mask_ids mask
+
+  let stamp_string th =
+    let reg = axiom_registry () in
+    let entry id =
+      let c = try List.assoc id reg with Not_found -> "<unregistered>" in
+      "id:" ^ string_of_int id ^ "=|- " ^ truncate_80 c in
+    String.concat "|" (List.map entry (stamp_of th))
 
