+  let rec compact_type_string ty =
+    match ty with
+      Tyvar v -> "'" ^ v
+    | Tyapp(f,[]) -> f
+    | Tyapp(f,args) ->
+        f ^ "(" ^ String.concat "," (List.map compact_type_string args) ^ ")"
+
+  (* Complete, fully typed, deterministic serialisation of a term.  Nothing  *)
+  (* is truncated; every variable and constant carries its type.            *)
+  let rec canonical_term_string tm =
+    match tm with
+      Var(s,ty) -> s ^ ":" ^ canonical_type_string ty
+    | Const(s,ty) -> s ^ ":" ^ canonical_type_string ty
+    | Comb(f,x) ->
