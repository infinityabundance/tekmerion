ix89_mark "A:init" THEN
MAP_EVERY X_GEN_TAC
 [`z:int64`; `x:int64`; `y:int64`; `m:num`; `n:num`; `pc:num`] THEN
REWRITE_TAC[C_ARGUMENTS; C_RETURN; SOME_FLAGS; NONOVERLAPPING_CLAUSES] THEN
DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
REWRITE_TAC[BIGNUM_FROM_MEMORY_BYTES] THEN ENSURES_INIT_TAC "s0" THEN
ix89_mark "A:digitize_m" THEN
BIGNUM_LDIGITIZE_TAC "m_" `read (memory :> bytes (x,8 * 4)) s0` THEN
ix89_mark "A:digitize_n" THEN
BIGNUM_LDIGITIZE_TAC "n_" `read (memory :> bytes (y,8 * 4)) s0` THEN
ix89_mark "B:start" THEN
ix89_mark "B:step01:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_ADD_P25519_EXEC [3;4;7;8;10;11;12;13] (1--1) THEN
ix89_mark "B:step02:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_ADD_P25519_EXEC [3;4;7;8;10;11;12;13] (2--2) THEN
ix89_mark "B:step03:acc" THEN
ARM_ACCSTEPS_TAC BIGNUM_ADD_P25519_EXEC [3;4;7;8;10;11;12;13] (3--3) THEN
ix89_mark "B:step04:acc" THEN
ARM_ACCSTEPS_TAC BIGNUM_ADD_P25519_EXEC [3;4;7;8;10;11;12;13] (4--4) THEN
ix89_mark "B:step05:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_ADD_P25519_EXEC [3;4;7;8;10;11;12;13] (5--5) THEN
ix89_mark "B:step06:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_ADD_P25519_EXEC [3;4;7;8;10;11;12;13] (6--6) THEN
ix89_mark "B:step07:acc" THEN
ARM_ACCSTEPS_TAC BIGNUM_ADD_P25519_EXEC [3;4;7;8;10;11;12;13] (7--7) THEN
ix89_mark "B:step08:acc" THEN
ARM_ACCSTEPS_TAC BIGNUM_ADD_P25519_EXEC [3;4;7;8;10;11;12;13] (8--8) THEN
ix89_mark "B:step09:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_ADD_P25519_EXEC [3;4;7;8;10;11;12;13] (9--9) THEN
ix89_mark "B:step10:acc" THEN
ARM_ACCSTEPS_TAC BIGNUM_ADD_P25519_EXEC [3;4;7;8;10;11;12;13] (10--10) THEN
ix89_mark "B:step11:acc" THEN
ARM_ACCSTEPS_TAC BIGNUM_ADD_P25519_EXEC [3;4;7;8;10;11;12;13] (11--11) THEN
ix89_mark "B:step12:acc" THEN
ARM_ACCSTEPS_TAC BIGNUM_ADD_P25519_EXEC [3;4;7;8;10;11;12;13] (12--12) THEN
ix89_mark "B:step13:acc" THEN
ARM_ACCSTEPS_TAC BIGNUM_ADD_P25519_EXEC [3;4;7;8;10;11;12;13] (13--13) THEN
ix89_mark "B:step14:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_ADD_P25519_EXEC [3;4;7;8;10;11;12;13] (14--14) THEN
ix89_mark "B:step15:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_ADD_P25519_EXEC [3;4;7;8;10;11;12;13] (15--15) THEN
ix89_mark "B:step16:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_ADD_P25519_EXEC [3;4;7;8;10;11;12;13] (16--16) THEN
ix89_mark "B:step17:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_ADD_P25519_EXEC [3;4;7;8;10;11;12;13] (17--17) THEN
ix89_mark "B:step18:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_ADD_P25519_EXEC [3;4;7;8;10;11;12;13] (18--18) THEN
ix89_mark "B:step19:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_ADD_P25519_EXEC [3;4;7;8;10;11;12;13] (19--19) THEN
ix89_mark "E:finalise_state" THEN
ENSURES_FINAL_STATE_TAC THEN ASM_REWRITE_TAC[] THEN STRIP_TAC THEN
ix89_mark "E:prep_bound" THEN
SUBGOAL_THEN `m DIV 2 EXP 192 < 2 EXP 63 /\ n DIV 2 EXP 192 < 2 EXP 63`
MP_TAC THENL
 [ix89_mark "E:pb1:pre" THEN
  MAP_EVERY UNDISCH_TAC [`m < p_25519`; `n < p_25519`] THEN
  REWRITE_TAC[p_25519] THEN
  ix89_mark "E:pb1:ARITH_TAC" THEN ARITH_TAC;
  ix89_mark "E:pb2:expand" THEN
  MAP_EVERY EXPAND_TAC ["m"; "n"] THEN
  CONV_TAC(ONCE_DEPTH_CONV BIGNUM_OF_WORDLIST_DIV_CONV) THEN
  ix89_mark "E:pb2:NUM_REDUCE_CONV" THEN
  DISCH_THEN(STRIP_ASSUME_TAC o CONV_RULE NUM_REDUCE_CONV)] THEN
ix89_mark "E:post_bound" THEN
ix89_mark "C:flag" THEN
SUBGOAL_THEN `carry_s13 <=> p_25519 <= m + n` SUBST_ALL_TAC THENL
 [ix89_mark "C:flag:pre" THEN
  MATCH_MP_TAC FLAG_FROM_CARRY_LE THEN EXISTS_TAC `256` THEN
  MAP_EVERY EXPAND_TAC ["m"; "n"] THEN
  REWRITE_TAC[p_25519] THEN
  ix89_mark "C:flag:NUM_REDUCE_CONV" THEN
  CONV_TAC NUM_REDUCE_CONV THEN
  ix89_mark "C:flag:decarrry" THEN
  REWRITE_TAC[bignum_of_wordlist; GSYM REAL_OF_NUM_CLAUSES] THEN
  ACCUMULATOR_ASSUM_LIST(fun ths -> ASSUM_LIST (fun thc ->
    MP_TAC(end_itlist CONJ (GEN_DECARRY_RULE thc ths)))) THEN
  DISCH_THEN(fun th -> REWRITE_TAC[th]) THEN
  ix89_mark "C:flag:BOUNDER_TAC" THEN BOUNDER_TAC[];
  ix89_mark "C:flag:cont" THEN ALL_TAC] THEN
ix89_mark "C:post_flag" THEN
ix89_mark "E:final:expand" THEN
CONV_TAC(LAND_CONV BIGNUM_EXPAND_CONV) THEN
ix89_mark "E:final:rewrite1" THEN
ASM_REWRITE_TAC[] THEN DISCARD_STATE_TAC "s19" THEN
ix89_mark "E:final:modadd" THEN
W(MP_TAC o PART_MATCH (lhand o rand) MOD_ADD_CASES o rand o snd) THEN
ASM_REWRITE_TAC[] THEN DISCH_THEN SUBST1_TAC THEN
ix89_mark "E:final:rewrite2" THEN
REWRITE_TAC[GSYM NOT_LE; COND_SWAP] THEN
REWRITE_TAC[GSYM REAL_OF_NUM_EQ] THEN ONCE_REWRITE_TAC[COND_RAND] THEN
SIMP_TAC[GSYM REAL_OF_NUM_SUB] THEN
ix89_mark "E:final:abbrev" THEN
ABBREV_TAC `bb <=> p_25519 <= m + n` THEN
MAP_EVERY EXPAND_TAC ["m"; "n"] THEN
REWRITE_TAC[GSYM REAL_OF_NUM_CLAUSES; bignum_of_wordlist; p_25519] THEN
ix89_mark "D:final:NUM_REDUCE_CONV" THEN
CONV_TAC NUM_REDUCE_CONV THEN
ix89_mark "E:final:cond" THEN
GEN_REWRITE_TAC (LAND_CONV o ONCE_DEPTH_CONV) [COND_RAND] THEN
FIRST_X_ASSUM(SUBST1_TAC o MATCH_MP (REAL_ARITH
 `e * c + s:real = z ==> s = z - e * c`)) THEN
ix89_mark "E:final:decarrry" THEN
ACCUMULATOR_ASSUM_LIST(fun ths -> ASSUM_LIST (fun thc ->
  MP_TAC(end_itlist CONJ (GEN_DECARRY_RULE thc ths)))) THEN
DISCH_THEN(fun th -> REWRITE_TAC[th]) THEN
ix89_mark "E:final:condcases" THEN
COND_CASES_TAC THEN ASM_REWRITE_TAC[BITVAL_CLAUSES] THEN
ix89_mark "D:final:REAL_ARITH_TAC" THEN
REAL_ARITH_TAC
