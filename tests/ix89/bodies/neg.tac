ix89_mark "A:init" THEN
MAP_EVERY X_GEN_TAC [`z:int64`; `x:int64`; `n:num`; `pc:num`] THEN
REWRITE_TAC[C_ARGUMENTS; C_RETURN; SOME_FLAGS; NONOVERLAPPING_CLAUSES] THEN
DISCH_THEN(REPEAT_TCL CONJUNCTS_THEN ASSUME_TAC) THEN
REWRITE_TAC[BIGNUM_FROM_MEMORY_BYTES] THEN ENSURES_INIT_TAC "s0" THEN
ix89_mark "A:digitize_n" THEN
BIGNUM_LDIGITIZE_TAC "n_" `read (memory :> bytes (x,8 * 4)) s0` THEN
ix89_mark "B:start" THEN
ix89_mark "B:step01:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_NEG_P25519_EXEC [4;6;9;12] (1--1) THEN
ix89_mark "B:step02:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_NEG_P25519_EXEC [4;6;9;12] (2--2) THEN
ix89_mark "B:step03:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_NEG_P25519_EXEC [4;6;9;12] (3--3) THEN
ix89_mark "B:step04:acc" THEN
ARM_ACCSTEPS_TAC BIGNUM_NEG_P25519_EXEC [4;6;9;12] (4--4) THEN
ix89_mark "B:step05:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_NEG_P25519_EXEC [4;6;9;12] (5--5) THEN
ix89_mark "B:step06:acc" THEN
ARM_ACCSTEPS_TAC BIGNUM_NEG_P25519_EXEC [4;6;9;12] (6--6) THEN
ix89_mark "B:step07:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_NEG_P25519_EXEC [4;6;9;12] (7--7) THEN
ix89_mark "B:step08:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_NEG_P25519_EXEC [4;6;9;12] (8--8) THEN
ix89_mark "B:step09:acc" THEN
ARM_ACCSTEPS_TAC BIGNUM_NEG_P25519_EXEC [4;6;9;12] (9--9) THEN
ix89_mark "B:step10:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_NEG_P25519_EXEC [4;6;9;12] (10--10) THEN
ix89_mark "B:step11:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_NEG_P25519_EXEC [4;6;9;12] (11--11) THEN
ix89_mark "B:step12:acc" THEN
ARM_ACCSTEPS_TAC BIGNUM_NEG_P25519_EXEC [4;6;9;12] (12--12) THEN
ix89_mark "B:step13:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_NEG_P25519_EXEC [4;6;9;12] (13--13) THEN
ix89_mark "B:step14:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_NEG_P25519_EXEC [4;6;9;12] (14--14) THEN
ix89_mark "B:step15:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_NEG_P25519_EXEC [4;6;9;12] (15--15) THEN
ix89_mark "B:step16:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_NEG_P25519_EXEC [4;6;9;12] (16--16) THEN
ix89_mark "B:step17:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_NEG_P25519_EXEC [4;6;9;12] (17--17) THEN
ix89_mark "B:step18:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_NEG_P25519_EXEC [4;6;9;12] (18--18) THEN
ix89_mark "B:step19:plain" THEN
ARM_ACCSTEPS_TAC BIGNUM_NEG_P25519_EXEC [4;6;9;12] (19--19) THEN
ix89_mark "E:finalise_state" THEN
ENSURES_FINAL_STATE_TAC THEN ASM_REWRITE_TAC[] THEN STRIP_TAC THEN
ix89_mark "E:final:expand" THEN
CONV_TAC(LAND_CONV BIGNUM_EXPAND_CONV) THEN
ASM_REWRITE_TAC[] THEN DISCARD_STATE_TAC "s19" THEN
ix89_mark "E:final:sym" THEN
CONV_TAC SYM_CONV THEN MATCH_MP_TAC EQUAL_FROM_CONGRUENT_MOD_MOD THEN
MAP_EVERY EXISTS_TAC [`256`; `if n = 0 then &0:real else &p_25519 - &n`] THEN
ix89_mark "E:final:conj" THEN
REPEAT CONJ_TAC THENL
 [ix89_mark "D:final:BOUNDER_TAC" THEN BOUNDER_TAC[];
  ix89_mark "D:final:ARITH_TAC.1" THEN
  REWRITE_TAC[p_25519] THEN ARITH_TAC;
  ix89_mark "D:final:ARITH_TAC.2" THEN
  REWRITE_TAC[p_25519] THEN ARITH_TAC;
  ix89_mark "E:final:b4_all" THEN
  ALL_TAC;
  ix89_mark "E:final:b5_setup" THEN
  COND_CASES_TAC THEN ASM_REWRITE_TAC[SUB_0; MOD_REFL] THEN
  ASM_SIMP_TAC[REAL_OF_NUM_SUB; REAL_OF_NUM_CLAUSES] THEN
  MATCH_MP_TAC MOD_LT THEN
  ix89_mark "D:final:ASM_ARITH_TAC" THEN ASM_ARITH_TAC] THEN
ix89_mark "E:final:rewrite1" THEN
EXPAND_TAC "n" THEN REWRITE_TAC[BIGNUM_OF_WORDLIST_EQ_0; ALL] THEN
REWRITE_TAC[VAL_EQ_0; WORD_SUB_EQ_0; WORD_OR_EQ_0] THEN
REWRITE_TAC[COND_SWAP; CONJ_ACI; bignum_of_wordlist] THEN
ix89_mark "E:final:condcases" THEN
COND_CASES_TAC THEN ASM_REWRITE_TAC[VAL_WORD_0; p_25519] THEN
ix89_mark "D:final:NUM_REDUCE_CONV" THEN
CONV_TAC NUM_REDUCE_CONV THEN CONV_TAC REAL_RAT_REDUCE_CONV THEN
ix89_mark "E:final:rewrite2" THEN
REWRITE_TAC[INTEGER_CLOSED; GSYM REAL_OF_NUM_CLAUSES] THEN
ACCUMULATOR_POP_ASSUM_LIST(MP_TAC o end_itlist CONJ o DESUM_RULE) THEN
DISCH_THEN(fun th -> REWRITE_TAC[th]) THEN
ix89_mark "D:final:REAL_INTEGER_TAC" THEN
REAL_INTEGER_TAC
